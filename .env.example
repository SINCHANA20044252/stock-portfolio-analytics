# Copy to .env (never commit .env). Used by docker compose and as a reference for hosting dashboards.

# ---- required in production ----
ENV=production
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
POSTGRES_PASSWORD=
# Direct run (not compose): postgresql+psycopg2://user:password@host:5432/portfolio?sslmode=require
DATABASE_URL=
# Comma-separated origins allowed to call the API with cookies
CORS_ORIGINS=https://your-app.vercel.app
COOKIE_SECURE=true
TRUST_PROXY=true

# ---- market data (choose one provider) ----
MARKET_DATA_PROVIDER=yahoo          # yahoo (no key, unofficial) | alphavantage | demo (no prices)
ALPHAVANTAGE_API_KEY=
DEFAULT_EXCHANGE_SUFFIXES=.NS,.BO
BENCHMARK_SYMBOL=^NSEI
RISK_FREE_RATE_PCT=7.0

# ---- optional AI wording ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- optional tuning ----
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
ENABLE_DOCS=false
RUN_MIGRATIONS=true
